{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch PrintQueue Server (macOS / lldb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/printqueue_server",
      "args": ["8080"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
