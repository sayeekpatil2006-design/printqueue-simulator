    {
      "name": "Run Queue Unit Tests (macOS / lldb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/test_runner",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "Build PrintQueue Server (Offline)"
    }
  ]
}
